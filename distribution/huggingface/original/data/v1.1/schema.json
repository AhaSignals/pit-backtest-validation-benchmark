{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahasignals.com/data/benchmarks/pit-backtest-validation/v1.1/schema.json",
  "title": "AhaSignals Financial AI Point-in-Time Integrity Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaUrl",
    "submissionSchemaUrl",
    "artifact",
    "researchQuestion",
    "design",
    "scope",
    "sourceResearchObjects",
    "cases",
    "baselineReport",
    "limitations",
    "citation",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "schemaUrl": {
      "type": "string",
      "format": "uri"
    },
    "submissionSchemaUrl": {
      "type": "string",
      "format": "uri"
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "canonicalUrl",
        "repositoryUrl",
        "publishedAt",
        "status",
        "conceptDoi",
        "dataLicense",
        "softwareLicense",
        "creator"
      ]
    },
    "researchQuestion": {
      "type": "string",
      "minLength": 1
    },
    "design": {
      "type": "object",
      "required": [
        "evaluationMode",
        "tracks",
        "sourceClock",
        "answerPolicy",
        "abstentionPolicy",
        "noLeaderboardClaim"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "caseCount",
        "promptCount",
        "issuerCount",
        "primaryFailureFamilies",
        "excludedClaims"
      ]
    },
    "sourceResearchObjects": {
      "type": "array",
      "minItems": 3
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "baselineReport": {
      "type": "object",
      "required": [
        "runId",
        "benchmarkId",
        "benchmarkVersion",
        "implementation",
        "systemClass",
        "result",
        "summary",
        "scoring",
        "results"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1
    },
    "citation": {
      "type": "object",
      "required": [
        "text",
        "bibtexKey"
      ]
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "canonicalization",
        "payloadSha256"
      ]
    }
  }
}
