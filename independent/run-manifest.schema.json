{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AhaSignals Financial AI PIT independent-run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "resultClass", "operator", "benchmark", "model", "execution", "artifacts", "score", "result", "boundary"],
  "properties": {
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "resultClass": {"const": "independent"},
    "operator": {"type": "string", "minLength": 2},
    "benchmark": {"type": "object"},
    "model": {"type": "object"},
    "execution": {"type": "object"},
    "artifacts": {"type": "object"},
    "score": {"type": "object"},
    "result": {"enum": ["pass", "fail"]},
    "boundary": {"type": "string", "minLength": 40}
  }
}
